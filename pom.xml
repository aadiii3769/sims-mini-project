<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ── Project coordinates ─────────────────────────────────────────── -->
    <groupId>com.sims</groupId>
    <artifactId>student-information-management-system</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Student Information Management System (SIMS)</name>
    <description>
        A standalone Java Swing desktop application with Oracle JDBC connectivity
        for academic administration. Built for UIT3361 (OOP Java) and UIT3311
        (Database Technology) laboratory evaluation.
    </description>

    <!-- ── Java version ─────────────────────────────────────────────────── -->
    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- dependency versions -->
        <ojdbc11.version>23.4.0.24.05</ojdbc11.version>
        <dotenv.version>5.2.2</dotenv.version>
        <exec.plugin.version>3.2.0</exec.plugin.version>
        <main.class>com.sims.Main</main.class>
    </properties>

    <!-- ── Dependencies ─────────────────────────────────────────────────── -->
    <dependencies>

        <!-- Oracle JDBC thin driver (ojdbc11 targets JDBC 4.3 / JDK 11+) -->
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc11</artifactId>
            <version>${ojdbc11.version}</version>
        </dependency>

        <!--
            dotenv-java: zero-dependency .env loader.
            Keeps credentials out of source code while still
            supporting System-property fallback in CI environments.
        -->
        <dependency>
            <groupId>io.github.cdimascio</groupId>
            <artifactId>dotenv-java</artifactId>
            <version>${dotenv.version}</version>
        </dependency>

    </dependencies>

    <!-- ── Build plugins ────────────────────────────────────────────────── -->
    <build>
        <plugins>

            <!-- Compiler plugin: enforce Java 17 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <!--
                exec-maven-plugin: launch the application without building
                a fat-jar.  Run with:  mvn exec:java
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec.plugin.version}</version>
                <configuration>
                    <mainClass>${main.class}</mainClass>
                    <!--
                        Pass --add-opens to allow Swing to access
                        internal JDK modules on JDK 17+
                    -->
                    <commandlineArgs>
                        --add-opens java.desktop/sun.awt=ALL-UNNAMED
                    </commandlineArgs>
                </configuration>
            </plugin>

            <!-- Shade plugin: optional fat-jar (mvn package -Pshade) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation=
                                    "org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${main.class}</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

</project>
